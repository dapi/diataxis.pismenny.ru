msgstr "учебные руководства"

#: ../../source/foundations.rst:67 ../../source/foundations.rst:79
msgid "acquires their craft"
msgstr "осваивает навык"

#: ../../source/foundations.rst:68 ../../source/foundations.rst:72
msgid "informs action"
msgstr "даёт информацию для действия"

#: ../../source/foundations.rst:69
msgid "goals"
msgstr "цели"

#: ../../source/foundations.rst:70
msgid "how-to guides"
msgstr "практические руководства"

#: ../../source/foundations.rst:71 ../../source/foundations.rst:75
